# ============================================================
# OnePlus 7T Pro 5G McLaren (HD1925 / hotdogg / sm8150)
# OOS 12 (HD1925_11_F.05) 4.14.180 内核
# SukiSU-Ultra (builtin, 自带 SUSFS) + 手动 hook
#
# 说明：官方 Android 12 源码树只有 hotdog(7T Pro)/hotdogb(7T) DTS，
# 没有 hotdogg(5G McLaren) 专用 DTS，因此只能用 hotdog 平台配置编译。
# 风险：5G(SDX50M 外挂基带) 可能失效，需 fastboot boot 实测确认。
# ============================================================

CONFIG_ENV=config/op7tp-mclaren-hd1925.env

# ---- 内核源码（OnePlus 官方 OOS12 分支，匹配本机 Android 12）----
KERNEL_SOURCE=https://github.com/OnePlusOSS/android_kernel_oneplus_sm8150
KERNEL_SOURCE_BRANCH=oneplus/sm8150_s_12.1_op7pro
KERNEL_CONFIG=vendor/sm8150-perf_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
KERNEL_NAME=op7tp-mclaren
ADD_LOCALVERSION_TO_FILENAME=false

# ---- 工具链（4.14 用较旧 clang，新版会炸 4.x 树）----
CLANG_BRANCH=master-kernel-build-2021
CLANG_VERSION=r416183b
USE_CUSTOM_CLANG=false
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# ---- KernelSU: SukiSU-Ultra builtin（唯一自带 SUSFS 的分支）----
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
# 4.14 非 GKI，kprobes 不可靠，用手动 hook
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# ---- SUSFS（内核态隐藏 root，银行 app 抗检测关键）----
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ---- 额外补丁 ----
# 4.14 < 5.9，KernelSU 需要 path_umount 回移才能正常卸载自身挂载
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ---- Kconfig ----
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false
# defconfig 已含 KALLSYMS_ALL=y / MODULES=y；补齐 LOCALVERSION
EXTRA_DEFCONFIG=CONFIG_LOCALVERSION="-g8ae7b4ca8564" CONFIG_LOCALVERSION_AUTO=n

# ---- AnyKernel3 / 打包 ----
USE_CUSTOM_ANYKERNEL3=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ---- Runner ----
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
